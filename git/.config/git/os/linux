# Linux credential helpers, linked as ~/.gitconfig.os by install.sh.
# gh only — GCM needs a desktop keyring a headless box doesn't have.
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
# No GitHub ssh key on Linux boxes: fetch git@github.com URLs (the nvim
# submodule, clone-bare's ssh remotes) over https instead.
[url "https://github.com/"]
	insteadOf = git@github.com:
