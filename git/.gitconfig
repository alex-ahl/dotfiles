# This is Git's per-user configuration file.
#
# The default identity is the personal one, deliberately: a repo that matches no
# rule gets the address that is safe to publish. Work identities are conditional
# and live in ~/.gitconfig.local, which is not tracked — see README, "Not tracked".
[user]
	name = Alexander Åhl
	email = 7934262+alex-ahl@users.noreply.github.com
[merge]
	ff = only
[pull]
	rebase = true
[include]
	path = ~/.gitconfig.local
# Credential helpers differ per OS; install.sh links ~/.gitconfig.os to the
# matching file under ~/.config/git/os/.
[include]
	path = ~/.gitconfig.os
