# This is Git's per-user configuration file.
[user]
	name = Alexander Åhl
# Identity and any employer-specific settings live in ~/.gitconfig.local, which
# is not tracked here. A missing include is not an error, so this file stands
# alone on a fresh machine — set user.email there before your first commit.
[include]
	path = ~/.gitconfig.local
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential]
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
