{
  "network": {
    "allowedDomains": [
      "*.githubusercontent.com",
      "api.anthropic.com",
      "platform.claude.com",
      "claude.ai",
      "api.github.com",
      "apps.apple.com",
      "files.pythonhosted.org",
      "github.com",
      "google.se",
      "pypi.org",
      "registry.npmjs.org",
      "www.google.se"
    ],
    "deniedDomains": [
      "*:22"
    ],
    "deniedDomainReasons": {
      "*:22": "SSH is not available in the sandbox (no key, no known_hosts). Run git network operations on the host."
    },
    "allowLocalBinding": true
  },
  "filesystem": {
    "allowRead": [
      "/"
    ],
    "denyRead": [
      "/Volumes"
    ],
    "allowWrite": [
      "~",
      "/Users/Shared",
      "/private/tmp",
      "/tmp"
    ],
    "denyWrite": [
      "/Users/Shared/sv-alex/**/.zshenv",
      "/Users/sandvault-alex/.zshenv",
      "/Users/Shared/sv-alex/**/.git/config",
      "/Users/Shared/sv-alex/**/.git/hooks/**",
      "/Users/Shared/sv-alex/**/.bare/config",
      "/Users/Shared/sv-alex/**/.bare/hooks/**"
    ]
  },
  "enableWeakerNetworkIsolation": true,
  "allowPty": true
}
