{
  "fileSuggestion": {
    "type": "command",
    "command": "$HOME/.scripts/shared/repo-file-suggestion.sh"
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch --show-current)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh label list:*)",
      "Bash(gh issue create:*)",
      "Bash(git add:*)",
      "Bash(git restore --staged:*)",
      "Write(//Users/alex/brain/**)",
      "Write(//Users/Shared/sv-alex/brain/**)",
      "Bash(grep:*)",
      "Bash(diff:*)",
      "Bash(bash -n:*)",
      "Bash(tmux -L wsg list-windows:*)",
      "Bash(tmux -L wsg list-panes:*)",
      "Bash(tmux -L wsg list-sessions:*)",
      "Bash(tmux -L wsg show-options:*)",
      "Bash(tmux -L wsg show-option:*)",
      "Read(//Users/alex/git/**)",
      "Read(//Users/Shared/sv-alex/git/**)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Edit(//Users/alex/handoffs/**)",
      "Edit(//Users/Shared/sv-alex/handoffs/**)",
      "Edit(//Users/alex/brain/**)",
      "Edit(//Users/Shared/sv-alex/brain/**)"
    ],
    "deny": [
      "Read(//Users/alex/git/**/.env)",
      "Read(//Users/Shared/sv-alex/git/**/.env)",
      "Read(//Users/alex/git/**/.env.*)",
      "Read(//Users/Shared/sv-alex/git/**/.env.*)",
      "Read(//Users/alex/git/**/*.pem)",
      "Read(//Users/Shared/sv-alex/git/**/*.pem)",
      "Read(//Users/alex/git/**/*.key)",
      "Read(//Users/Shared/sv-alex/git/**/*.key)",
      "Read(//Users/alex/git/**/id_rsa*)",
      "Read(//Users/Shared/sv-alex/git/**/id_rsa*)",
      "Read(//Users/alex/git/**/*.p12)",
      "Read(//Users/Shared/sv-alex/git/**/*.p12)",
      "Read(//Users/alex/git/**/.npmrc)",
      "Read(//Users/Shared/sv-alex/git/**/.npmrc)",
      "Read(//Users/alex/git/**/credentials*)",
      "Read(//Users/Shared/sv-alex/git/**/credentials*)"
    ],
    "additionalDirectories": [
      "/Users/alex/handoffs",
      "/Users/alex/brain",
      "/Users/Shared/sv-alex/handoffs",
      "/Users/Shared/sv-alex/brain"
    ]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "microsoft-docs@claude-plugins-official": true,
    "remember@claude-plugins-official": false
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "skipDangerousModePermissionPrompt": true
}
